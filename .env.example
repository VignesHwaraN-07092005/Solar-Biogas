# Biogas Intelligence Platform - Environment Configuration Template
APP_NAME="Biogas Intelligence Platform"
APP_ENV="development"
DEBUG=false
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (comma-separated origins)
# For production, specify your exact domain: e.g. "https://yourdomain.com"
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000"

# Database Configuration (SQLite default for local development, PostgreSQL ready)
DATABASE_URL="sqlite:///./solar_biogas.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/solar_biogas"

# Operating Mode: "DEMO" (Synthetic/Research data) or "LIVE" (ESP32 hardware)
SYSTEM_MODE="DEMO"

# Sensor Safety Thresholds
ALERT_PH_MIN=6.5
ALERT_PH_MAX=8.2
ALERT_TEMP_MIN=28.0
ALERT_TEMP_MAX=42.0
ALERT_PRESSURE_WARN=1.30
ALERT_PRESSURE_MAX=1.50
ALERT_BATTERY_SOC_MIN=20.0

# Device / Connectivity
DEVICE_OFFLINE_THRESHOLD_MINUTES=60

# Conversational AI Assistant (Optional - Google Gemini)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-flash-lite-latest"
